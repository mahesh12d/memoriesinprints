# Postgres connection string.
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/memories_in_prints
# Hosted: add ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/memories_in_prints"

# Public base URL, used to build links in emails.
APP_URL="http://localhost:3000"

# Outbound email.
#   log     every message is written to .mail/ as .html and nothing is sent
#   resend  sent through Resend, using RESEND_API_KEY below
#   smtp    sent through the SMTP_* settings below
# Leave this on "log" in development. Anything unrecognised also writes to
# disk, so a misconfigured environment can never quietly mail a real customer.
MAIL_TRANSPORT="log"
MAIL_FROM="Memories in Prints <studio@memoriesinprints.co.uk>"

# Resend, used when MAIL_TRANSPORT=resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# SMTP, used when MAIL_TRANSPORT=smtp.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Where quote requests are delivered.
STUDIO_ENQUIRIES_EMAIL=""

# Cloudflare R2, for proof artwork and catalogue photographs.
# Without all four of these the app writes to .uploads/ on disk instead, and
# a production build refuses to store anything at all.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# PAYPAL_ENV is "sandbox" or "live". Anything other than "live" is sandbox,
# so a typo keeps you on test money rather than taking real payments.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Set to 1 only when traffic actually reaches the app through Cloudflare.
# It makes rate limiting trust the CF-Connecting-IP header, which Cloudflare
# overwrites and so cannot be forged — but which anyone could send directly
# if the site is not behind Cloudflare.
TRUST_CLOUDFLARE_HEADERS="0"

# Google sign-in. The redirect URI registered in Google Cloud Console must be
# <APP_URL>/api/auth/callback/google for every environment you deploy to.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upstash Redis, for rate limiting. Without these the limiter falls back to an
# in-process counter, which on a serverless host means the limit applies per
# instance rather than per site — fine locally, far too loose in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
