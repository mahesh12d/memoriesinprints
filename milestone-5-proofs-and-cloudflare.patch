+          variant="secondary"
+          pendingLabel="Returning…"
+        >
+          Return to designer
+        </SubmitButton>
+      </form>
+    </div>
+  );
+}
+
+export function AssignDesignerForm({
+  orderId,
+  designers,
+  currentDesignerId,
+}: {
+  orderId: string;
+  designers: { id: string; name: string }[];
+  currentDesignerId: string | null;
+}) {
+  const [state, formAction] = useActionState(
+    assignDesignerAction,
+    emptyFormState,
+  );
+
+  return (
+    <form action={formAction} className="flex flex-col gap-3">
+      <FormMessage state={state} />
+      <input type="hidden" name="orderId" value={orderId} />
+
+      <label className="flex flex-col gap-2">
+        <span className="text-[13px] font-semibold text-ink-soft">Designer</span>
+        <select
+          name="designerId"
+          defaultValue={currentDesignerId ?? ""}
+          className="rounded-[3px] border border-field-line bg-white px-3 py-2.5 text-sm"
+        >
+          <option value="">Unassigned</option>
+          {designers.map((designer) => (
+            <option key={designer.id} value={designer.id}>
+              {designer.name}
+            </option>
+          ))}
+        </select>
+      </label>
+
+      <SubmitButton
+        className="self-start"
+        variant="secondary"
+        pendingLabel="Saving…"
+      >
+        Save assignment
+      </SubmitButton>
+    </form>
+  );
+}
